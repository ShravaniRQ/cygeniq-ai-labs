# ---------------------------------------------------------------------------
# Cygeniq AI Labs Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the .env file to source control.
# ---------------------------------------------------------------------------

# --- LLM ---
# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# --- Database ---
# Supabase PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[db]
SUPABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres

# --- Microsoft SharePoint (Azure AD App Registration) ---
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret

# Optional: comma-separated email domains allowed to upload documents to SharePoint
# Default when unset: cygeniq.com,cygeniq.local,gmail.com
ALLOWED_TENANT_DOMAINS=cygeniq.com,cygeniq.local

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# API key required on the X-API-Key header for every /chat request.
# Leave blank (or omit) to run in dev mode with no authentication.
# Recommended in production: generate with:  python -c "import secrets; print(secrets.token_hex(32))"
CYGENIQ_API_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Directory where the SQLite memory database (cygeniq_memory.db) is stored.
# In Docker, set this to /app/data and mount a persistent volume there.
# Locally, defaults to ./data (auto-created on startup).
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Internal APIs (future use)
# ---------------------------------------------------------------------------
INTERNAL_API_BASE=https://internal-mcp.company.local
INTERNAL_API_TOKEN=your_oauth_token_here
