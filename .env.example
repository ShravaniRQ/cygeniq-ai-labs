# --- Model API Keys ---
# If using Grok via OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# If using Google Gemini (active selection based on settings)
GOOGLE_API_KEY=your_google_api_key_here

# --- Database ---
SUPABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres

# --- Internal APIs (HR/GRC) ---
INTERNAL_API_BASE=https://internal-mcp.company.local
INTERNAL_API_TOKEN=your_oauth_token_here
